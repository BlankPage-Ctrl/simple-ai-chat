{
  "name": "simple-ai-chat",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --hot src/index.ts",
    "start:proxy": "node --env-file-if-exists=proxy/.env proxy/src/index.js",
    "dev:proxy": "node --env-file-if-exists=proxy/.env --watch proxy/src/index.js",
    "build:ui": "bun --cwd ui build",
    "build:embed": "bun scripts/embed-ui.ts",
    "build:linux": "bun run build:ui && bun run build:embed && bun build --compile --target=bun-linux-x64 --outfile=simple-chat ./src/index.ts",
    "build:windows": "bun run build:ui && bun run build:embed && bun build --compile --target=bun-windows-x64 --outfile=simple-chat.exe ./src/index.ts",
    "build": "bun run build:linux"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ai": "^7.0.51",
    "hono": "^4.13.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "zod": "^4.4.3"
  }
}
